{
  "name": "shtts-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "npm run typecheck && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "check": "vp check && npm run typecheck",
    "build:wasm": "wasm-pack build ../bindings/web --target web --release --out-dir ../../target/web --out-name shtts -- --locked",
    "pack:wasm": "node ../scripts/package.mjs"
  },
  "dependencies": {
    "shtts-wasm": "0.1.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  }
}
